{
  "name": "campus-resource-graph-backend",
  "version": "1.0.0",
  "description": "Multi-Model NoSQL Backend for Campus Resource Dependency & Recommendation Graph",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-db": "tsx scripts/check-db.ts",
    "seed": "tsx scripts/seed.ts",
    "benchmark": "tsx scripts/benchmark-nosql.ts",
    "benchmark:reproducible": "tsx scripts/run-phase11-benchmark.ts"
  },
  "dependencies": {
    "cassandra-driver": "^4.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "mongoose": "^8.9.5",
    "neo4j-driver": "^5.27.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
